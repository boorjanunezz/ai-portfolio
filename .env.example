# Clave de la API de Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Solo se usa en servidor. NUNCA la prefijes con NEXT_PUBLIC_.
GEMINI_API_KEY=

# Modelo de Gemini. Cámbialo aquí o en Vercel sin tocar código.
# Recomendado: gemini-3.5-flash-lite (gratis, rápido). Si falla en rechazos, prueba gemini-3.8-flash.
# La serie 2.5 está restringida a cuentas que ya la usaban: no la uses en proyectos nuevos.
GEMINI_MODEL=gemini-3.5-flash-lite
