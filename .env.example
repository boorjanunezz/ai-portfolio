# Clave de la API de Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Solo se usa en servidor. NUNCA la prefijes con NEXT_PUBLIC_.
GEMINI_API_KEY=

# Modelo de Gemini. Cámbialo aquí o en Vercel sin tocar código.
# Por defecto: gemma-4-26b-a4b-it (medido: 1-3 s, 10/10 correctas, cuota gratuita propia).
# Déjalo vacío para usar el valor por defecto. La serie 2.5 está restringida a cuentas antiguas.
GEMINI_MODEL=

# Opcional: modelos de respaldo, separados por comas, si el principal está saturado o tarda.
# Por defecto: gemini-3.5-flash,gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=

# Opcional pero recomendado: Groq como respaldo gratuito cuando Gemini está saturado.
# Crea la key en https://console.groq.com/keys. Solo servidor.
GROQ_API_KEY=
# Modelo de Groq. Por defecto: openai/gpt-oss-120b
GROQ_MODEL=
