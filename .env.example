# Clave de la API de Gemini (Google AI Studio: https://aistudio.google.com/apikey).
# Solo se usa en servidor. NUNCA la prefijes con NEXT_PUBLIC_.
GEMINI_API_KEY=

# Modelo de Gemini. Cámbialo aquí o en Vercel sin tocar código.
# Ejemplos: gemini-2.5-flash, gemini-2.5-flash-lite, gemini-2.5-pro
GEMINI_MODEL=gemini-2.5-flash
